# Paste into Dokploy's Environment editor. Do not commit filled-in values.
APP_ORIGIN=https://app.yourdomain.com
# Generate 64 random hex characters: openssl rand -hex 32
# Use only letters/numbers here because Compose inserts it into DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
# Keep false until `npm run check` passes and the wallets are funded.
MAINNET_ENABLED=false
MEMECOIN_MINT=
OWNER_WALLET=
# Two different wallets. Base58 secret key, or a quoted JSON array of 64 bytes.
OPS_PRIVATE_KEY=
POOL_PRIVATE_KEY=
SOLANA_RPC_URL=
DAS_RPC_URL=
JUPITER_API_KEY=
COLLECTOR_CRYPT_API_KEY=
COLLECTOR_CRYPT_PAYMENT_WALLET=GachaNgyXTU3zFogQ8Z5jR2BLXs8215X2AtEH18VxJq3
GAS_RESERVE_SOL=0.05
SLIPPAGE_BPS=100
